<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CardPayment</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/masterView.css"/>
    <link rel="stylesheet" href="~/CardPayment.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 header-nav-body">
            <div class="container-fluid">
                <div class="header-img col-lg-6">
                    <img src="/images/NV LOGO.jpeg" />
                </div>
                <div class="header-text col-lg-6">
                    <p>
                        NV NutriNest – Fresh Bites, Bright Minds
                    </p>
                </div>
            </div>
        </nav> 
    </header>
    @RenderBody()
    
    

   @*  <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CardPayment - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script id="bolt" src="https://checkout-static.citruspay.com/bolt/run/bolt.min.js" bolt-="" color="#e76521" bolt-logo="assets/img/payumoney.png"></script>
    @await RenderSectionAsync("Scripts", required: false)
